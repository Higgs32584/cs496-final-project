# Copy this file to `.env` and fill in the values. `.env` is never committed.

# MongoDB connection strings.
# The server uses TESTDB_URI unless NODE_ENV=production or DB_TARGET=main is set.
DB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/main
TESTDB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/test

# Signs the session cookies. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional settings, shown with their defaults.
# DB_TARGET=test
# CLIENT_ORIGIN=http://localhost:3000
# HOST=localhost
# PORT=4000
