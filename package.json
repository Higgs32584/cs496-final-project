{
  "name": "cs496-final-project",
  "private": true,
  "scripts": {
    "start": "node ProjectServer.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./test/globalSetup.js",
    "globalTeardown": "./test/globalTeardown.js",
    "setupFiles": [
      "./test/setupEnv.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/my-app/"
    ],
    "collectCoverageFrom": [
      "app.js",
      "controller/**/*.js",
      "model/**/*.js",
      "util/*.js"
    ]
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "6.0.14"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongodb-session": "^3.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "memorystore": "^1.6.7",
    "mongoose": "^6.9.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
